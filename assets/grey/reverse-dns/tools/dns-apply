#!/usr/bin/env bash
# dns-apply - rebuild the reverse DNS zones with the exercise teams the control server sends.
# Installed to /usr/local/sbin/dns-apply by install.sh. Runs as root.
#
# The range control server runs it over SSH with a key that can run nothing else:
#   dns-apply overlay < overlay.csv     save the exercise overlay, then rebuild the zones
#   dns-apply status                    print what is loaded (md5 of the overlay, zone serials)
# Anything else is refused. The overlay is checked before it is saved; a bad one changes nothing.
#
# License: GPL-3.0, Dire Wolf Security.

set -euo pipefail

HERE="@HERE@"
OVERLAY="@OVERLAY@"
ZONE_DIR="/etc/bind/zones/rdns"

# Over SSH the command the client asked for is in SSH_ORIGINAL_COMMAND; by hand it is "$*".
request="${SSH_ORIGINAL_COMMAND:-$*}"

case "$request" in
    overlay)
        tmp="$(mktemp)"
        trap 'rm -f "$tmp"' EXIT
        # Read at most 1 MB from stdin: an overlay for a handful of teams is a few KB.
        head -c 1048576 > "$tmp"
        if [[ -s "$tmp" ]]; then
            source "$HERE/dns.conf"
            base="$HERE/$REGISTRY_FILE"
            [[ "$REGISTRY_FILE" == /* ]] && base="$REGISTRY_FILE"
            python3 "$(dirname "$base")/registry.py" "$base" --overlay "$tmp" || { echo "dns-apply: overlay refused, nothing changed"; exit 2; }
        fi
        # Keep the old overlay, so a failed rebuild can put it back.
        old="$(mktemp)"
        if [[ -f "$OVERLAY" ]]; then cp "$OVERLAY" "$old"; else : > "$old"; fi
        install -D -m 644 "$tmp" "$OVERLAY"
        cd "$HERE"
        if ! bash install.sh --go --quiet > /var/log/dns-apply.log 2>&1; then
            install -m 644 "$old" "$OVERLAY"
            rm -f "$old"
            tail -n 20 /var/log/dns-apply.log
            echo "dns-apply: rebuild failed, the old overlay is back"
            exit 1
        fi
        rm -f "$old"
        lines=0
        [[ -s "$OVERLAY" ]] && lines=$(($(grep -c . "$OVERLAY") - 1))
        echo "dns-apply: ok, $lines exercise network(s) loaded"
        ;;
    status)
        if [[ -s "$OVERLAY" ]]; then echo "overlay $(md5sum < "$OVERLAY" | cut -c1-32)"; else echo "overlay none"; fi
        for f in "$ZONE_DIR"/db.*; do
            [[ -f "$f" ]] || continue
            z="${f##*/db.}"
            echo "$z serial $(awk '/IN SOA/ {for (i = 1; i <= NF; i++) if ($i == "(") print $(i + 1)}' "$f")"
        done
        ;;
    *)
        echo "dns-apply: only 'overlay' and 'status' are allowed (got '$request')" >&2
        exit 64
        ;;
esac
