# Line endings. The repo stores LF; these rules decide what lands on disk.
* text=auto

# Runs on Linux (Proxmox, Raspberry Pi): always LF, even when checked out on Windows.
*.sh          text eol=lf
*.py          text eol=lf
*.service     text eol=lf
*.timer       text eol=lf
*.conf        text eol=lf
*.interfaces  text eol=lf
*.php         text eol=lf
registrar-apply  text eol=lf
assets/**/etc/**  text eol=lf

# Runs on Windows.
*.ps1         text eol=crlf

# Never touch.
*.png   binary
*.jpg   binary
*.gif   binary
*.pdf   binary
*.docx  binary
*.xlsx  binary
*.zip   binary
